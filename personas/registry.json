{
  "version": "2.0.0",
  "description": "5 套内容使命正交的人设标准",
  "personas": [
    {
      "id": "peer_diary",
      "label": "同龄人日记",
      "status": "active",
      "file": "standards/peer_diary.json",
      "defaultAudienceId": "workplace_newcomer",
      "compatibleAudienceIds": [
        "college_student",
        "workplace_newcomer",
        "light_saver",
        "investment_beginner"
      ],
      "contentTypes": [
        "personal-exp",
        "brand-seed"
      ],
      "variants": [
        { "id": "campus", "label": "校园探索生" },
        { "id": "salary", "label": "打工人日记" },
        { "id": "literary", "label": "职场随笔" }
      ]
    },
    {
      "id": "concept_teacher",
      "label": "理财教学博主",
      "status": "active",
      "file": "standards/concept_teacher.json",
      "defaultAudienceId": "investment_beginner",
      "compatibleAudienceIds": [
        "investment_beginner",
        "light_saver"
      ],
      "contentTypes": [
        "stock-tutorial",
        "finance-tips"
      ]
    },
    {
      "id": "hotspot_observer",
      "label": "市场观察员",
      "status": "active",
      "file": "standards/hotspot_observer.json",
      "defaultAudienceId": "hotspot_follower",
      "compatibleAudienceIds": [
        "hotspot_follower",
        "young_professional",
        "busy_worker"
      ],
      "contentTypes": [
        "hotspot-analysis"
      ]
    },
    {
      "id": "sober_guard",
      "label": "清醒搞钱女孩",
      "status": "active",
      "file": "standards/sober_guard.json",
      "defaultAudienceId": "young_professional",
      "compatibleAudienceIds": [
        "young_professional",
        "hotspot_follower"
      ],
      "contentTypes": [
        "finance-tips",
        "hotspot-analysis"
      ]
    },
    {
      "id": "family_planner",
      "label": "家庭 CFO",
      "status": "active",
      "file": "standards/family_planner.json",
      "defaultAudienceId": "family_planner",
      "compatibleAudienceIds": [
        "family_planner",
        "wechat_native"
      ],
      "contentTypes": [
        "finance-tips",
        "brand-seed"
      ]
    }
  ],
  "routingTable": [
    {
      "if": "大学生/零花钱语境",
      "use": "peer_diary",
      "variant": "campus"
    },
    {
      "if": "打工人工资时间线+可执行方法",
      "use": "peer_diary",
      "variant": "salary"
    },
    {
      "if": "普通职场生活记录、不要教程感",
      "use": "peer_diary",
      "variant": "literary"
    },
    {
      "if": "要讲懂一个概念",
      "use": "concept_teacher"
    },
    {
      "if": "有新闻/热点要解读",
      "use": "hotspot_observer"
    },
    {
      "if": "要批判跟风/避坑判断",
      "use": "sober_guard"
    },
    {
      "if": "有娃/家庭长期规划",
      "use": "family_planner"
    }
  ]
}
