# =============================================================
# C3-V2.2 环境变量模板
# 复制为 .env.local 后填写，不要提交 .env.local 到版本库
# =============================================================

# 知识库路径（默认 ai-knowledge-base-v5.0，一般无需修改）
# AI_KNOWLEDGE_BASE_PATH=ai-knowledge-base-v5.0

# ---------- 文字生成（必填，服务端读取，不暴露给前端） ----------
LLM_API_KEY=
LLM_API_URL=https://api.deepseek.com/v1/chat/completions
LLM_MODEL=deepseek-chat

# ---------- 图片生成：火山方舟 Seedream（推荐） ----------
# 完整路径必须是 /api/v3/images/generations（切勿写成 /v1/images/generations）
IMAGE_API_KEY=
IMAGE_API_URL=https://ark.cn-beijing.volces.com/api/v3/images/generations
# 到方舟控制台「开通管理」复制已开通模型的 Model ID，或填推理接入点 ep-xxx
# 常见模型：
#   doubao-seedream-5-0-pro-260628   # 5.0 pro，最高质量，单张 60-80s（推荐）
#   doubao-seedream-4-5-251128       # 4.5，单张 3-8s，适合快速调试
#   doubao-seedream-4-0-250828       # 4.0，单张 3-5s
IMAGE_MODEL=doubao-seedream-5-0-pro-260628
IMAGE_API_FORMAT=volcengine

# 如需切换到 OpenAI DALL·E，改为：
# IMAGE_API_URL=https://api.openai.com/v1/images/generations
# IMAGE_MODEL=dall-e-3
# IMAGE_API_FORMAT=openai

# ---------- 热点搜索（可选，跳过不影响主流程） ----------
TAVILY_API_KEY=
