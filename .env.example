# 知识库（默认 ai-knowledge-base-v5.0）
# AI_KNOWLEDGE_BASE_PATH=ai-knowledge-base-v5.0

# 文字生成（必填，服务端读取，不暴露给前端）
LLM_API_KEY=
LLM_API_URL=https://api.deepseek.com/v1/chat/completions
LLM_MODEL=deepseek-chat

# 图片生成（可选，火山引擎方舟 Seedream）
IMAGE_API_KEY=
# 完整路径必须是 /api/v3/images/generations（勿写成 /v1/images/generations）
IMAGE_API_URL=https://ark.cn-beijing.volces.com/api/v3/images/generations
# 到方舟控制台「开通管理」复制已开通模型的 Model ID，或填推理接入点 ep-xxx
# 示例：doubao-seedream-4-5-251128 / doubao-seedream-4-0-250828
IMAGE_MODEL=doubao-seedream-4-5-251128
IMAGE_API_FORMAT=volcengine

# 热点搜索（可选）
TAVILY_API_KEY=
